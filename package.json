{
  "name": "nestjs-verify-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Self-hosted Twilio Verify-style OTP for NestJS. Bring your own SMS or email provider.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jadedm/nestjs-verify.git"
  },
  "author": "jadedm <jadedmanish@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "check:exports": "node scripts/check-exports.mjs",
    "check:packed": "node scripts/check-packed.mjs",
    "check:release-plan": "node scripts/check-release-plan.mjs",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "test:adapters": "docker compose -f scripts/docker-compose.smoke.yml up -d --wait && pnpm build && node scripts/smoke-adapters.mjs; ec=$?; docker compose -f scripts/docker-compose.smoke.yml down -v; exit $ec",
    "test:adapters:mongo-drivers": "docker compose -f scripts/docker-compose.smoke.yml up -d --wait mongo && pnpm build && node scripts/smoke-mongo-drivers.mjs; ec=$?; docker compose -f scripts/docker-compose.smoke.yml down -v; exit $ec"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@jadedm/nestjs-verify": "workspace:*",
    "@jadedm/nestjs-verify-gupshup": "workspace:*",
    "@jadedm/nestjs-verify-mongo": "workspace:*",
    "@jadedm/nestjs-verify-postgres": "workspace:*",
    "@jadedm/nestjs-verify-redis": "workspace:*",
    "@swc/core": "^1.15.41",
    "@types/node": "^20.11.0",
    "ioredis": "^5.4.0",
    "mongodb": "^6.5.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@>=5.0.0 <5.4.1": "^5.4.1",
      "esbuild@>=0.27.0 <0.28.1": "^0.28.2",
      "argparse@<2": "^2.0.1"
    }
  }
}
